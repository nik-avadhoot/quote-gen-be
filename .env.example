# Comma-separated list of allowed browser origins for CORS.
# Defaults to the production frontend + local Vite dev server if unset.
CORS_ORIGINS=

# Supabase project API URL.
SUPABASE_URL=

# Anon/publishable key — respects RLS. Used for auth.get_user() /
# sign_in_with_password() / refresh_session() (things a browser could do).
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — bypasses RLS. Used for admin user management and to
# re-read the caller's profile row on every authenticated request.
# Backend-only. Never expose this to the frontend.
SUPABASE_SECRET_KEY=

# Reserved for local JWKS-based JWT verification. Currently unused — token
# verification instead calls Supabase's own /auth/v1/user endpoint via
# auth.get_user(), which is the recommended approach for HS256 projects.
SUPABASE_JWKS_URL=
